<view class="page">
  <view class="error-box" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{loaded && !alerts.length && !error}}">
    <text class="empty-title">还没有提醒</text>
    <text>到了止盈、止损或前高附近，会记在这里。配好微信推送后，同一条也会发到微信。</text>
  </view>
  <view class="card" wx:for="{{alerts}}" wx:key="id">
    <view class="card-top">
      <text class="name">{{item.title}}</text>
      <text class="quiet">{{item.time}}</text>
    </view>
    <text class="line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="index">{{line}}</text>
    <text class="line {{item.ok ? 'down' : 'up'}}">{{item.status}}</text>
  </view>
  <tab-bar active="alerts" />
</view>
